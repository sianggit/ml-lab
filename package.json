{
  "name": "nextjs-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "mui:split:all": "npx jscodeshift -t mui-split-imports.js app src --extensions=tsx,ts,js,jsx --parser=tsx",
    "mui:split": "node mui-split-changed.js",
    "clean-imports": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "clean-imports:staged": "eslint --fix",
    "format": "prettier --write .",
    "format:changed": "git diff --name-only --diff-filter=ACMR | xargs prettier --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/material": "^7.3.1",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.23.12",
    "he": "^1.2.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "react-scroll": "^1.9.0",
    "reicon-react": "^1.1.2",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svgr/webpack": "^8.1.0",
    "@types/he": "^1.2.3",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-scroll": "^1.8.10",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.40.0"
  },
  "lint-staged": {
    "{app,src}/**/*.{js,jsx,ts,tsx}": [
      "npm run mui:split",
      "eslint --fix",
      "npm run format:changed"
    ],
    "*.{json,css,md}": [
      "npm run format:changed"
    ]
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
